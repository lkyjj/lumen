# Required for live ModelScope LLM/VLM calls.
MODELSCOPE_API_KEY=ms-replace-with-a-new-token

# Required for live DashScope image/video/TTS calls.
DASHSCOPE_API_KEY=sk-replace-with-a-new-key

# Optional deployment metadata. Never put a token in a Git remote URL.
MODELSCOPE_USER=your-modelscope-user
STUDIO_NAME=lumen

# Optional runtime overrides.
LUMEN_BUDGET_CAP=300
LUMEN_BUDGET_WARN=200
MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1

# Recommended DashScope business-space endpoint. The Key, workspace and endpoint
# must belong to the same region (China North 2 / Beijing for this project).
DASHSCOPE_WORKSPACE_ID=llm-replace-with-your-workspace-id
# DASHSCOPE_NATIVE_BASE_URL=https://llm-your-id.cn-beijing.maas.aliyuncs.com/api/v1
# DASHSCOPE_OPENAI_BASE_URL=https://llm-your-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

LUMEN_LLM_MODEL=Qwen/Qwen3.5-35B-A3B
LUMEN_VLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
LUMEN_IMAGE_MODEL=wan2.6-t2i
LUMEN_VIDEO_MODEL=wan3.0-video
LUMEN_VIDEO_STABLE_MODEL=wan2.7-i2v-2026-04-25
LUMEN_VIDEO_CHEAP_MODEL=wan2.6-i2v-flash
LUMEN_TTS_MODEL=cosyvoice-v3-flash
LUMEN_TTS_VOICE_SYSTEM=replace-with-an-enabled-system-voice-id
LUMEN_TTS_VOICE_HUMAN=replace-with-another-enabled-system-voice-id
